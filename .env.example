# Runtime database connection (Supabase PostgreSQL pooler URL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Required in production. Use a cryptographically random value of at least 32 characters.
SESSION_SECRET=replace-with-a-long-random-secret

# Required only when running Drizzle migration commands.
DRIZZLE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Optional override for the origin that serves production frontend bundles.
# Keep this unset on Railway to use https://managerplanner.up.railway.app.
PUBLIC_ASSET_ORIGIN=https://managerplanner.up.railway.app
