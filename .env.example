# Runtime database connection (Supabase PostgreSQL pooler URL)
DATABASE_TARGET=supabase
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Separate migration target; ignored unless DATABASE_TARGET=yandex.
YANDEX_PG_HOST=YOUR_HOST.mdb.yandexcloud.net
YANDEX_PG_PORT=6432
YANDEX_PG_DATABASE=managerplanner
YANDEX_PG_USER=user1
YANDEX_PG_PASSWORD=
# Download the official Yandex CA and mount it in the deployment filesystem.
YANDEX_PG_SSL_CA_FILE=.local/certs/yandex-postgresql-ca.pem

# Required in production. Use a cryptographically random value of at least 32 characters.
SESSION_SECRET=replace-with-a-long-random-secret

# Secret for the OneDrive Sync + PowerShell scheduled importer.
PLAN_IMPORT_TOKEN=replace-with-a-long-random-import-token

# Required only when running Drizzle migration commands.
DRIZZLE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Optional override for the production frontend bundle origin.
# Leave empty to serve assets directly from the Yandex Cloud container.
PUBLIC_ASSET_ORIGIN=

# Yandex 360 / Identity Hub OIDC. Leave empty to keep local password login only.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER=https://auth.yandex.cloud
OIDC_AUTHORIZATION_URL=https://auth.yandex.cloud/oauth/authorize
OIDC_TOKEN_URL=https://auth.yandex.cloud/oauth/token
OIDC_USERINFO_URL=https://auth.yandex.cloud/oauth/userinfo
OIDC_JWKS_URL=
OIDC_REDIRECT_URI=https://АДРЕС-ПРИЛОЖЕНИЯ/api/auth/yandex/callback
OIDC_SCOPE=openid email profile
OIDC_PROMPT=select_account
APP_BASE_URL=https://АДРЕС-ПРИЛОЖЕНИЯ
