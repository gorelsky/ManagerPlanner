# Runtime database connection (Supabase PostgreSQL pooler URL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Supabase Auth settings. VITE_ variables are embedded into the client build.
VITE_SUPABASE_URL=https://PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Use a long random value in production.
SESSION_SECRET=replace-with-a-long-random-secret

# Required only when running Drizzle migration commands.
DRIZZLE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
